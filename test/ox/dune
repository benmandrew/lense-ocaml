; OxCaml goldens. mixed.t runs in `dune test` with the vendored OxCaml
; frontend. mixed_oracle.t compiles and runs OxCaml programs, so it needs
; the OxCaml compiler (see that file); run it with
; `dune build @test/ox/runtest-ox`.

(cram
 (applies_to mixed)
 (deps (package lense-ocaml) mixed.ml))

(cram
 (applies_to units)
 (deps (package lense-ocaml)))

(cram
 (applies_to mixed_oracle)
 (runtest_alias false)
 (alias runtest-ox)
 (deps (env_var OXCAML_BIN)))
