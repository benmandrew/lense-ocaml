; lense_core compiled to JavaScript for the web front end. The stdlib .cmi
; files are embedded at /static/stdlib, the load path the type checker uses.
; Build with: dune build web/jsoo/lense_web.bc.js

(executable
 (name lense_web)
 (modes js)
 (optional)
 (enabled_if (>= %{ocaml_version} 5.5))
 (libraries lense_model lense_core js_of_ocaml)
 (js_of_ocaml
  (compilation_mode whole_program)
  (flags (:standard (:include cmi_flags.sexp)))))

(rule
 (enabled_if (>= %{ocaml_version} 5.5))
 (deps (glob_files %{ocaml_where}/*.cmi))
 (action
  (with-stdout-to cmi_flags.sexp
   (run sh -c "printf '('; for f in \"$1\"/*.cmi; do printf ' --file=%s:/static/stdlib/' \"$f\"; done; printf ')\\n'" sh %{ocaml_where}))))

; Building the JavaScript takes a while, so plain `dune build` skips it.
(rule (alias default) (action (progn)))
